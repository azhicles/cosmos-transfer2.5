# API image layered on top of the Cosmos Transfer base image.
#
# Build the base image first (it carries the full CUDA + model environment):
#   # Ampere - Hopper:
#   docker build -f Dockerfile  --build-arg STANDALONE=true -t cosmos-transfer2:base .
#   # Blackwell (e.g. RTX Pro 6000 Blackwell):
#   docker build -f docker/nightly.Dockerfile --build-arg STANDALONE=true -t cosmos-transfer2:base .
#
# Then build this API image (or use docker-compose.yml, which does both wiring for you):
#   docker build -f Dockerfile.api --build-arg BASE_IMAGE=cosmos-transfer2:base -t cosmos-transfer2-api .

ARG BASE_IMAGE=cosmos-transfer2:base
FROM ${BASE_IMAGE}

WORKDIR /workspace

# Add the API server dependencies into the existing uv-managed virtualenv.
# (fastapi / uvicorn / pyyaml are usually already present from the base env; this is idempotent
# and additionally pulls in python-multipart for uploads and anthropic for prompt upsampling.)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /workspace/.venv/bin/python \
        "fastapi>=0.110" "uvicorn[standard]>=0.30" "python-multipart>=0.0.9" \
        "anthropic>=0.40" "pyyaml>=6.0"

# Copy the API package + guide last so iterating on API code doesn't rebuild the heavy layers.
COPY cosmos_transfer2/api /workspace/cosmos_transfer2/api
COPY API_GUIDE.md /workspace/API_GUIDE.md

ENV PATH="/workspace/.venv/bin:$PATH"
# Defaults; override via env / docker-compose. Outputs land on a mounted volume.
ENV COSMOS_API_OUTPUT_DIR=/workspace/outputs/api \
    COSMOS_API_PRELOAD=edge \
    COSMOS_API_LOG_LEVEL=INFO

EXPOSE 8000

ENTRYPOINT []
CMD ["uvicorn", "cosmos_transfer2.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
